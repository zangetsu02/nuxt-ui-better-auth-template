
# Generate with: npx auth secret (left empty, Better Auth refuses to start in production)
NUXT_BETTER_AUTH_SECRET=
NUXT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
NUXT_DATABASE_URL=postgres://user:password@localhost:5432/postgres
NUXT_APP_URL=http://localhost:3000
NUXT_APP_NAME=My Nuxt App
NODE_ENV=development
NUXT_APP_REPO=https://github.com/myorg/my-nuxt-app
NUXT_APP_NOTIFY_EMAIL=notify@example.com
NUXT_APP_CONTACT_EMAIL=contact@example.com
